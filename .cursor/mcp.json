{
  "mcpServers": {
    "hwp-automation": {
      "type": "stdio",
      "command": "python",
      "args": ["${workspaceFolder}/tools/hwp-mcp/run.py"],
      "env": {}
    },
    "local-http-mcp": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:8080/mcp"
    },
    "superpowers": {
      "type": "stdio",
      "command": "python",
      "args": ["C:/Users/user/.cursor/mcp-servers/superpowers-mcp/run.py"],
      "env": {}
    }
  }
}
